{
    admin off
    auto_https off
}

:8080 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control no-store
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
