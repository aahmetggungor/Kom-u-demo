# Synthetic local development only. Run python scripts/configure_local.py first.
KOMSU_DATABASE_URL=postgresql+psycopg://komsu_app:replace@127.0.0.1:55432/komsu
KOMSU_ADMIN_DATABASE_URL=postgresql+psycopg://postgres:replace@127.0.0.1:55432/komsu
KOMSU_ENVIRONMENT=development
KOMSU_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Generate a private 32-byte base64 key; never copy this placeholder into a deployment.
KOMSU_AUDIO_MASTER_KEY_B64=replace-with-base64-32-byte-secret
KOMSU_AUDIO_KEY_ID=development-audio-v1
# Optional pinned local Whisper directory; transcription worker stays disabled when absent.
# KOMSU_WHISPER_MODEL_DIR=models/whisper-tiny
# No public geocoder or tile endpoint by default.
# Optional local-only OPUS model pack provisioned by scripts/download_translation_models.py.
# KOMSU_TRANSLATION_MODEL_DIR=models/opus-mt
# Optional localhost Prometheus endpoint for the per-tenant worker.
# KOMSU_WORKER_METRICS_PORT=9101
